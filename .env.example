# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Required: from Google AI Studio -> Get API key
GEMINI_API_KEY=

# Recommended: fine-grained GitHub token (public repositories, read-only, no extra permissions).
# Enables README and commit message analysis and raises GitHub's rate limit.
GITHUB_TOKEN=

# Optional: models to try in order (best first). These are the defaults:
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
